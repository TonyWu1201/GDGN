{
  "hidden_dim": 256,
  "n_layers": 2,
  "heads_ppi": 4,
  "heads_dti": 2,
  "dropout": 0.3,
  "lr": 1e-4,
  "weight_decay": 1e-5,
  "lambda_dti": 10.0,
  "pos_weight_ppi": 1.0,
  "pos_weight_dti": 1.0,
  "mask_ppi_ratio": 0.20,
  "mask_dti_ratio": 0.40,
  "neg_ratio": 1.0,
  "heldout_ppi_ratio": 0.01,
  "heldout_dti_ratio": 0.20,
  "batch_condition": 16,
  "max_epochs": 50,
  "patience": 10,
  "lr_patience": 5,
  "lr_factor": 0.5,
  "clip_grad": 5.0,
  "seed": 42,
  "eval_cell_batch_size": 8,
  "metrics_combine": "hits_aware",
  "dti_margin_alpha": 0.5,
  "dti_margin_gamma": 2.0
}